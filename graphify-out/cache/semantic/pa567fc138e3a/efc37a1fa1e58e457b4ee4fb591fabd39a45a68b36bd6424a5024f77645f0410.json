{"nodes": [{"id": "docs_specs_0005_clean_session_reuse_rationale_document", "label": "Clean session reuse rationale", "file_type": "document", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0005_clean_session_reuse_rationale_conservative_pool_owner", "label": "Conservative pool owner", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown extension and user code state cannot be proven clean by DISCARD ALL; qualified built-in state provides one provable reuse path."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_discard_all", "label": "PostgreSQL DISCARD ALL", "file_type": "concept", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0005_clean_session_reuse_rationale_sticky_eligibility", "label": "Sticky eligibility recognizer", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown work remains dedicated without requiring a SQL parser dependency."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_exact_startup_isolation", "label": "Exact startup isolation and generation snapshot", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exact startup values and a coherent generation snapshot prevent ownership and invalidation holes before handoff."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_physical_ownership_permits", "label": "Physical ownership permits", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cleanup and idle sockets must remain charged against the physical connection budget."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_synchronous_pool_mutex", "label": "Bounded synchronous pool mutex", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Existing sessions own connector futures and cancellation-safe values; a mutex with no await avoids a separate owner task and request channels."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_credential_only_sighup", "label": "Credential-only SIGHUP", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credential rotation fits the authorized slice without adding the scope 009 administration and reload surface."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_safe_baseline_search_paths", "label": "Four exact safe baseline search paths", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role paths placing attacker schemas before pg_catalog can change signed literal operator resolution; other paths remain dedicated."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_profile_permission", "label": "pg_read_all_settings qualification permission", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conservative qualification needs preload setting visibility; missing permission retains dedicated execution rather than granting access."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_observed_search_path", "label": "Observed startup search_path", "file_type": "rationale", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real PostgreSQL startup messages exposed the missing search_path allowlist field after three PID reuse tests failed."}, {"id": "docs_specs_0005_clean_session_reuse_rationale_postgresql_18_docs", "label": "PostgreSQL 18 DISCARD, RESET and message-flow documentation", "file_type": "document", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0005_clean_session_reuse_rationale_prd_002", "label": "PRD-002 pooling behavior", "file_type": "document", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0005_clean_session_reuse_rationale_spec_0005", "label": "Spec 0005 settled design", "file_type": "document", "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_specs_0005_clean_session_reuse_rationale_document", "target": "docs_specs_0005_clean_session_reuse_rationale_conservative_pool_owner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/0005-clean-session-reuse/rationale.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs