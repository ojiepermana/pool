{"nodes": [{"id": "docs_specs_0004_one_real_primary_path_rationale_document", "label": "Spec 0004 rationale", "file_type": "document", "source_file": "docs/specs/0004-one-real-primary-path/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0004_one_real_primary_path_rationale_single_backend_impl", "label": "Reuse first party backend handshake code for probes and sessions", "file_type": "rationale", "source_file": "docs/specs/0004-one-real-primary-path/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A separate PostgreSQL driver would add packages, duplicate TLS/SCRAM paths and introduce sockets into control."}, {"id": "docs_specs_0004_one_real_primary_path_rationale_thin_path_choice", "label": "Build the whole thin client path with two pure/core crate boundaries", "file_type": "rationale", "source_file": "docs/specs/0004-one-real-primary-path/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This satisfies the requested walking slice, enables wire fuzzing and preserves the architecture without adding a new scope."}, {"id": "docs_specs_0004_one_real_primary_path_rationale_publish_before_journal", "label": "Publish closed in memory snapshot before conflict latch persistence", "file_type": "rationale", "source_file": "docs/specs/0004-one-real-primary-path/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Waiting on a failed journal must not leave old open admission published."}, {"id": "docs_specs_0004_one_real_primary_path_rationale_query_inflight", "label": "Connection loss while Query in flight reports uncertain transaction outcome", "file_type": "rationale", "source_file": "docs/specs/0004-one-real-primary-path/rationale.md", "source_loc