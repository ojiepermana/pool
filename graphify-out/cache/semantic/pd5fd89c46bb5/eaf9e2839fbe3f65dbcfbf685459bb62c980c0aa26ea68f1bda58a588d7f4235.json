{"nodes": [{"id": "docs_prd_005_health_monitoring", "label": "Health monitoring PRD", "file_type": "document", "source_file": "docs/prd/005-health-monitoring.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_005_health_monitoring_probeobservation", "label": "ProbeObservation", "file_type": "concept", "source_file": "docs/prd/005-health-monitoring.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_005_health_monitoring_healthstate", "label": "HealthState (Unknown, Healthy, Suspect, Unavailable, Recovering)", "file_type": "concept", "source_file": "docs/prd/005-health-monitoring.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_prd_005_health_monitoring_unknown_lag", "label": "Lag computed only for comparable fresh positions; missing evidence is unknown (AC-2)", "file_type": "rationale", "source_file": "docs/prd/005-health-monitoring.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No freshness guarantee is derived only from time since last replay; missing or expired WAL evidence is reported as unknown and excludes replica admission."}, {"id": "docs_prd_005_health_monitoring_authenticated_probes", "label": "Bounded authenticated probes with dedicated monitor role", "file_type": "rationale", "source_file": "docs/prd/005-health-monitoring.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reachability alone cannot identify a safe writable primary or a sufficiently current replica, so probes authenticate with a least privilege monitor role, fixed queries, verified TLS and reserved capacity."}, {"id": "docs_prd_005_health_monitoring_health_failure_no_promotion", "label": "Health failure alone produces no pro