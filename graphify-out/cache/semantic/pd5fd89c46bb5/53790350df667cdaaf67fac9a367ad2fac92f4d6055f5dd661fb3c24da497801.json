{"nodes": [{"id": "docs_specs_0001_initial_architecture_index", "label": "Spec 0001. POOL initial architecture", "file_type": "document", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_modular_daemon_decision", "label": "Modular daemon with independent CLI decision", "file_type": "rationale", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Decision", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for the four VM scenario, small operational surface and vertical delivery; the separate controller executable is deferred until multiple proxies need a single authority."}, {"id": "docs_specs_0001_initial_architecture_index_proposed_stack", "label": "Proposed stack", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_tokio", "label": "Tokio runtime with bounded tasks and channels", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fits long lived socket workloads; a thread per client is simpler but costly at high idle connection counts."}, {"id": "docs_specs_0001_initial_architecture_index_wire_state_machine", "label": "Hand written wire state machine on bytes and tokio::net", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps framing and state visible; a PostgreSQL client driver belongs in monitoring, not in the data path."}, {"id": "docs_specs_0001_initial_architecture_index_rustls", "label": "rustls and tokio-rustls TLS", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_pg_query", "label": "pg_query 18.1.0 behind an adapter", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": "https://github.com/pganalyze/pg_query.rs", "captured_at": null, "author": null, "contributor": null, "rationale": "Favors PostgreSQL 18 grammar coverage over a pure Rust build (sqlparser runner up); the native code must be isolated, bounded, reviewed and fuzzed."}, {"id": "docs_specs_0001_initial_architecture_index_toml_serde_config", "label": "Typed Serde configuration from TOML", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_admin_rest_api", "label": "Versioned local admin REST API (Axum)", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equivalent operator capabilities without copying PCP initially; remote administration needs mTLS and role authorization."}, {"id": "docs_specs_0001_initial_architecture_index_prometheus_tracing", "label": "prometheus-client metrics and tracing logs", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_etcd_future_coordination", "label": "External etcd for future coordination", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Proposed stack", "source_url": "https://etcd.io/docs/v3.6/learning/api_guarantees/", "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse established consensus; an embedded consensus library creates a larger storage and operations obligation."}, {"id": "docs_specs_0001_initial_architecture_index_data_control_plane_separation", "label": "Data plane and control plane separation", "file_type": "rationale", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The data plane reads immutable topology snapshots and never does blocking journal work, infrastructure calls or consensus per query; control publishes snapshots only after validation."}, {"id": "docs_specs_0001_initial_architecture_index_shared_process_failure_domain", "label": "Shared process failure domain", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Boundaries", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepted consequence of one daemon; bounded probe tasks, timeouts and resource limits reduce the risk and process isolation remains a future extraction option."}, {"id": "docs_specs_0001_initial_architecture_index_safety_contracts", "label": "Ten safety contracts", "file_type": "rationale", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Safety contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0001_initial_architecture_index_virtual_cancellation_credentials", "label": "Per lease virtual cancellation credentials", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Safety contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real backend keys stay private and a backend is retired after any forwarded cancellation so uncertain delivery cannot reach a later lease; the promise is isolation across leases."}, {"id": "docs_specs_0001_initial_architecture_index_deferred_features", "label": "Deferred features (cache, automatic failover, native replication, multiplexing)", "file_type": "concept", "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": "Safety contracts", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_specs_0001_initial_architecture_index", "target": "docs_specs_0001_initial_architecture_index_modular_daemon_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_0001_initial_architecture_index", "target": "docs_specs_0001_initial_architecture_index_proposed_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_0001_initial_architecture_index", "target": "docs_specs_0001_initial_architecture_index_data_control_plane_separation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/0001-initial-architecture/index.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_0001_initial_architecture_index", "target": "docs_specs_0001_initial_architecture_index_shared_process_failure_domain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/0001-initial-architecture/index.md", "source