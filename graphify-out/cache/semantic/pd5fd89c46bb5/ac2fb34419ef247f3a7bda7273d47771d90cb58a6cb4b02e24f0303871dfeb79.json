{"nodes": [{"id": "docs_plan_decision_ledger", "label": "Planning assumptions and decisions", "file_type": "document", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_tracer_bullet_build_approach", "label": "Tracer Bullet build approach", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove a real protocol path through the system before adding breadth."}, {"id": "docs_plan_decision_ledger_ga_verification_depth", "label": "GA verification depth for data safety features", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data safety features require verification, tests, independent review and documentation."}, {"id": "docs_plan_decision_ledger_first_deployment_topology", "label": "First deployment: one proxy VM, primary and two replicas on Proxmox", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_failover_and_caching_boundary", "label": "Manual failover first; automatic failover and cache disabled", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed safety boundary from the brief: manual failover first, automatic failover and caching stay disabled."}, {"id": "docs_plan_decision_ledger_one_daemon_process_boundary", "label": "One daemon with separate modules plus separate CLI", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single daemon process boundary confirmed; split processes deferred."}, {"id": "docs_plan_decision_ledger_routing_decision", "label": "Routing decision: primary default, explicit read only session profiles", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoint chosen at login, SQL admitted on pinned lease, lag screened at admission only, eventual reads, no primary fallback. Arbitrary sessions never move between servers; continuous staleness guarantees and transparent mixed-session routing are deferred."}, {"id": "docs_plan_decision_ledger_terminated_scram_frontend_authentication", "label": "Terminated SCRAM over TLS with optional mTLS and separate backend credentials", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend authentication is terminated at the proxy; backend credentials are separately provisioned. Implementation needs a feature spec."}, {"id": "docs_plan_decision_ledger_sqlite_journal", "label": "SQLite journal for operations, audit and approved writer/epoch/quarantine", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local persistence stores durable authorization but never observed backend role truth; bootstrap once and reconcile with fresh roles before restart admission."}, {"id": "docs_plan_decision_ledger_tokio_runtime", "label": "Tokio runtime with bounded tasks and queues", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_rustls_tls", "label": "rustls and tokio-rustls with one crypto provider", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_pg_query_parser", "label": "pg_query parser with PostgreSQL 18 grammar", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Native code is isolated and reviewed."}, {"id": "docs_plan_decision_ledger_axum_admin_api", "label": "Axum REST administration API plus CLI", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected local transport and mTLS for remote exposure; PCP compatibility deferred."}, {"id": "docs_plan_decision_ledger_prometheus_observability", "label": "Prometheus metrics and tracing logs", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_apache_2_0_license", "label": "Apache 2.0 license", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_plan_decision_ledger_independent_review_resolutions", "label": "Independent review resolutions (seven approved fixes)", "file_type": "concept", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Another model critiqued the design; all seven recommended fixes were approved and applied. It is a design review, not a test, audit or certification."}, {"id": "docs_plan_decision_ledger_approved_writer_epoch_quarantine", "label": "Persisted approved writer, epoch and quarantine", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Observed role was confused with authorized writer after restart; durable authorization must agree with fresh probes and incomplete effects are reconciled."}, {"id": "docs_plan_decision_ledger_private_backend_keys", "label": "Private backend keys and virtual frontend cancellation credentials", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancellation could arrive after lease reuse; serialize retirement and close the physical backend after forwarding."}, {"id": "docs_plan_decision_ledger_operator_credential_map", "label": "Operator map from verified principal and database to backend identity", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Credential selection authority was implicit; make it an explicit operator map with secret reference and generation."}, {"id": "docs_plan_decision_ledger_acquisition_retry_limit", "label": "Retry only before initial lease and ReadyForQuery exposure", "file_type": "rationale", "source_file": "docs/plan/decision-ledger.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acquisition retry wording could imply session replacement; never retry after established session loss."}, {"id": "docs_plan_decision_ledger_authoritative_write_barrier", "label": "Authoritative barrier across every write path", "file_type": "rationale", "source_