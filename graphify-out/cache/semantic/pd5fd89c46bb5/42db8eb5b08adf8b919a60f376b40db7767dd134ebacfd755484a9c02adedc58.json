{"nodes": [{"id": "docs_architecture_failover_recovery", "label": "Failover and recovery", "file_type": "document", "source_file": "docs/architecture/failover-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_failover_recovery_manual_failover", "label": "Manual failover policy", "file_type": "rationale", "source_file": "docs/architecture/failover-recovery.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A transport timeout or failed health probe never authorizes promotion; PostgreSQL requires preventing the former primary from returning as another primary."}, {"id": "docs_architecture_failover_recovery_promotion_operation_stages", "label": "Promotion operation stages (Plan, Quiesce, Fence, Revalidate, Promote, Reconcile, Recover)", "file_type": "concept", "source_file": "docs/architecture/failover-recovery.md", "source_location": "Operation boundary", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_failover_recovery_candidate_rpo_policy", "label": "Candidate and RPO policy", "file_type": "concept", "source_file": "docs/architecture/failover-recovery.md", "source_location": "Candidate and RPO policy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest LSN alone cannot establish that every acknowledged commit survived; no zero data loss claim is inferred from asynchronous replication."}, {"id": "docs_architecture_failover_recovery_all_writer_barrier", "label": "All-writer write barrier", "file_type": "concept", "source_file": "docs/architecture/failover-recovery.md", "source_location": "Candidate and RPO policy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A final flush target can only be claimed after a barrier covering every writer path, including con