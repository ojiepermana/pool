{"nodes": [{"id": "claude", "label": "Claude Code guidance (CLAUDE.md)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_planned_architecture", "label": "Planned Architecture", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec 0001 was ratified on 2026-11-14 but its lifecycle status intentionally stays Proposed until the foundation is built."}, {"id": "claude_data_plane_vs_control_plane", "label": "Data Plane vs Control Plane Separation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The data plane reads immutable versioned topology snapshots and never does blocking journal work, infrastructure calls or consensus per query. Control publishes a snapshot only after validation. Both planes share one process failure domain in the initial daemon."}, {"id": "claude_session_model", "label": "Session Model (pinned backend lease)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A backend lease is pinned to one frontend for the whole session with no transaction or statement multiplexing. The route is chosen at login; later SQL is admitted or rejected on the pinned lease and never moves endpoint. Replica profiles have no primary fallback; clients reconnect to change profile or recover from backend loss."}, {"id": "claude_identity", "label": "Separate Frontend and Backend Identity", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend and backend authentication are separate; an operator configured map resolves verified principal plus database to backend login, credential reference and routing profile. Unmapped combinations fail."}, {"id": "claude_cancellation", "label": "Virtual Cancellation Model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The session manager issues per lease virtual cancellation credentials and keeps real backend keys private. A backend is retired after any forwarded cancellation."}, {"id": "claude_stack", "label": "Technology Stack (Tokio, rustls, pg_query, Axum, SQLite journal)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Planned architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand written wire state machine on bytes and tokio::net with no client driver in the data path; pg_query sits behind an adapter; SQLite journal has one writer."}, {"id": "claude_planned_commands", "label": "Planned Cargo Check Commands", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Current state and commands", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repository is documentation only; cargo fmt, clippy and test are planned commands and must not be reported as executed checks."}, {"id": "claude_working_with_the_docs", "label": "Working with the Docs", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Working with the docs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each fact has one owning file. Feature status advances only with linked build and test evidence; documentation alone never moves a feature to implemented or tested."}], "edges": [{"source": "claude", "target": "agents", "relat