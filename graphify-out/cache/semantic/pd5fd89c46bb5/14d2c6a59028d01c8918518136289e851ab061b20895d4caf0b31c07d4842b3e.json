{"nodes": [{"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum", "label": "Aturan umum brief: 001-stack-and-workspace (general brief rules)", "file_type": "document", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_sub_session_flow", "label": "Sub session flow (read brief, general rules, role file, invoke skill, work in existing worktree)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_foreign_role_files", "label": "Role files written for another project (Stackly references do not apply)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role files still mention cargo xtask, swift test, stackly-*, crates/protocol/, evidence/ and docs/scope/01-foundation.md, none of which exist in this repo; the brief's own verification commands and verify.md evidence replace them."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_standby_first_turn", "label": "Standby first turn of a new session (STATUS: standby until lead sends 'mulai')", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_graph_query_before_read", "label": "Query the knowledge graph before reading files (graphify query / explain)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locate code, contracts and decisions through the graph in the main checkout and open files only at the locations it points to."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_graph_update_ownership", "label": "Graph update ownership: sub sessions never touch graphify-out, lead refreshes it in the merge commit", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify-out/ is tracked in git, so per-branch graph updates would make graph.json conflict between branches; the lead updates the graph on main inside each merge commit instead, deviating from AGENTS.md step 6 for sub session commits."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_lead_session", "label": "Lead session: Stack and workspace coordination [0c7929]", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_forbidden_paths", "label": "Always forbidden paths for sub sessions (docs/scope, docs/prd, AGENTS.md, CLAUDE.md, graphify-out, .claude, spec content outside ownership)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_decision_mode_auto", "label": "Decision mode auto (architect asks lead to accept spec; others interpret ambiguous criteria, needs-decision only when spec text must change)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_allowed_downloads", "label": "Allowed downloads (crates adopted by build notes, pinned Rust toolchain, container images only with running Docker daemon)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_manual_steps_policy", "label": "Manual steps policy (Docker Desktop, GitHub settings, PR, push, system tools, real PostgreSQL or VM are user only; blocked steps recorded as BLOCKED owner user)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steps needing the user's hands, accounts or permission are never run by a session; a failed or flaky step is not a manual step and must be reported as failed with command and output."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_linux_build_evidence", "label": "Linux build evidence (a macOS build is not proof of the Linux build)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_disk_constraint", "label": "Disk constraint (29 GiB free, max 2 full Rust builds, CARGO_PROFILE_DEV_DEBUG=0, CARGO_INCREMENTAL=0, delete target/ before done)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The machine had 29 GiB free (94% used) on 2026-11-14, so concurrent builds and build artifacts are capped and each worktree cleans its own target/."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_process_constraints", "label": "Process constraints (no listener, no PostgreSQL contact, no real credentials, fixtures only including fake secrets for redaction tests)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_verification_before_report", "label": "Verification before reporting (cargo fmt, clippy, test with --locked, check-config fixtures, Linux build, clean git status, ownership-only diff)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_skill_panel_answers", "label": "Skill panel answers (preset answers because AskUserQuestion does not wake the lead)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AskUserQuestion does not wake the lead, so every skill panel is answered from a fixed list or escalated to the lead as needs-decision."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_commit_convention", "label": "Commit convention (conventional commits per Build plan step, subject 'type(scope): spec 0001 step n', spec status Proposed to In Progress)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L20", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_final_report_rule", "label": "Final report rule (one report per item via SendMessage, done only when committed, clean tree and merged main; STATUS line first)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_session_model_per_role", "label": "Session model per role (architect, debugger, checker on fable-5-2; developer, tester on opus-5-5)", "file_type": "concept", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_scope_001_authorization", "label": "Scope 001 authorization (/coordinate run on 2026-11-14 is the explicit request to build scope 001 only)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user running /coordinate on '1. Stack and workspace' is treated as the explicit implementation request; scope 002 and later are not worked on."}, {"id": "docs_scope_coordination_001_stack_and_workspace_brief_umum_slice_boundary", "label": "Slice boundary (minimal Linux daemon build plus offline config validation; no listener, live query, session pool or admin API)", "file_type": "rationale", "source_file": "docs/scope/coordination/001-stack-and-workspace.brief-umum.md", "source_locat