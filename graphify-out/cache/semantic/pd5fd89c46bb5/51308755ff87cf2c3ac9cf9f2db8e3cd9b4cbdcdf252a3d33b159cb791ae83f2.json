{"nodes": [{"id": "docs_specs_0002_standards_and_tooling_rationale", "label": "Standards and tooling rationale", "file_type": "document", "source_file": "docs/specs/0002-standards-and-tooling/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0002_standards_and_tooling_rationale_context", "label": "Context: scope 001 rules checked by hand; ARM target; pushes to main", "file_type": "rationale", "source_file": "docs/specs/0002-standards-and-tooling/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_0002_standards_and_tooling_rationale_option_1", "label": "Option 1: shell entry point, Rust check program, GitHub Actions, PR-only main (chosen)", "file_type": "rationale", "source_file": "docs/specs/0002-standards-and-tooling/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CI failure and local reproduction are the same command; custom rules have unit tests; scope 001 criteria stay true"}, {"id": "docs_specs_0002_standards_and_tooling_rationale_option_2", "label": "Option 2: off the shelf tools only", "file_type": "rationale", "source_file": "docs/specs/0002-standards-and-tooling/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: no tool checks scope status or project IDs; link checker brings its own dependency graph"}, {"id": "docs_specs_0002_standards_and_tooling_rationale_option_3", "label": "Option 3: Python script for document and workspace checks", "file_type": "rationale", "source_file": "docs/specs/0002-standards-and-tooling/rationale.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: second unpinned language for Rust reviewers"}, {"id": "docs_